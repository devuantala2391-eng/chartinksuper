# TimescaleDB Configuration
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=chartink
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=123

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123

# API Configuration
DEFAULT_SIZE=200
DEFAULT_CANDLE_COUNT=2000

# Latest Candle Cron Job Configuration
# Enable/disable the background cron job that fetches latest candles
LATEST_CANDLE_CRON_ENABLED=true

# Interval in minutes between latest candle updates (default: 1 minute for testing)
LATEST_CANDLE_CRON_INTERVAL=1

# Whether to run only during market hours (9:15 AM - 3:30 PM IST, Monday-Friday)
# Set to false to run 24/7 regardless of market hours (good for testing)
LATEST_CANDLE_MARKET_HOURS_ONLY=false

# Show live debug timer in console every 5 seconds (for debugging)
# Set to false to disable console debug output
LATEST_CANDLE_DEBUG_TIMER=true