{
  "watch": [
    "server.js",
    "services/",
    "routes/",
    "config/",
    "utils/",
    "middleware/"
  ],
  "ignore": [
    "node_modules/",
    "db/",
    "precalculatedStorage/",
    "precalculatedIndicators.json",
    "stock-screener/",
    "*.log",
    "*.tmp",
    ".git/"
  ],
  "ext": "js,json",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true
}