# Bulk Processing Configuration for RefreshDB

# Number of concurrent requests (default: 100)
# Reduce if API rate limiting occurs, increase for faster processing
CONCURRENT_LIMIT=100

# Alternative configurations for different scenarios:
# For conservative processing (lower server load): CONCURRENT_LIMIT=50
# For maximum speed (high server capacity): CONCURRENT_LIMIT=200
# For testing (very small batches): CONCURRENT_LIMIT=10

# Note: Higher values = faster processing but more server load
# Lower values = slower but more stable processing